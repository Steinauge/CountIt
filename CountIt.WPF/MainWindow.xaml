<Window x:Class="CountIt.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CountIt.WPF.Controls"
        Title="CountIt - Phasen &amp; Abschnitte" Height="650" Width="850"
        Background="#1E1E1E" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Titel & Hauptbefehle -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="CountIt" Margin="0,0,20,0" FontSize="22" FontWeight="Bold" Foreground="#00FF7F" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="📂 Laden" Command="{Binding LoadFromFileCommand}" 
                        Padding="8,5" Background="#2D2D2D" Foreground="White" Margin="0,0,8,0" BorderBrush="#555"/>
                <Button Content="💾 Speichern unter..." Command="{Binding SaveToFileCommand}" 
                        Padding="8,5" Background="#2D2D2D" Foreground="White" Margin="0,0,15,0" BorderBrush="#555"/>
                <Button Content="+ Neuer Abschnitt (Punkte übernehmen)" Command="{Binding AddSectionCommand}" 
                        Padding="10,5" Background="#2D2D2D" Foreground="White" BorderBrush="#00FF7F" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>

        <!-- Liste der Abschnitte -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Kasten für einen Abschnitt -->
                        <Border Background="#252525" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20" Padding="15">
                            <StackPanel>
                                <!-- Abschnitt-Header mit Name & Optionen -->
                                <DockPanel Margin="0,0,0,12">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             FontSize="16" FontWeight="Bold" Foreground="#00FF7F" 
                                             Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#555"
                                             MinWidth="150" VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="+ Zähler hinzufügen" 
                                                Command="{Binding AddCounterCommand}" 
                                                Background="#333" Foreground="#00FF7F" Padding="8,4" Margin="0,0,8,0" BorderBrush="#00FF7F"/>

                                        <Button Content="Abschnitt löschen 🗑" 
                                                Command="{Binding DataContext.RemoveSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                CommandParameter="{Binding}"
                                                Background="#550000" Foreground="White" Padding="8,4"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Liste der Zähler (CounterItems) im Abschnitt -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#333" CornerRadius="5" Margin="0,0,0,8" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Name, Hotkeys, Sound & Lautstärke -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                                 FontSize="14" FontWeight="SemiBold"
                                                                 Foreground="White" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#555" Margin="0,0,10,6"/>

                                                        <WrapPanel Margin="0,2,0,0">
                                                            <!-- Hotkey + -->
                                                            <TextBlock Text="+ :" Foreground="#00FF7F" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                            <controls:HotkeyControl Hotkey="{Binding IncrementHotkey, Mode=TwoWay}" Width="70" Background="#222" Foreground="White" Margin="0,0,6,0"/>

                                                            <!-- Hotkey - -->
                                                            <TextBlock Text="- :" Foreground="#FF6B6B" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                            <controls:HotkeyControl Hotkey="{Binding DecrementHotkey, Mode=TwoWay}" Width="70" Background="#222" Foreground="White" Margin="0,0,12,0"/>

                                                            <!-- Sound-Buttons -->
                                                            <Button Content="🎵" Command="{Binding SelectSoundCommand}" Background="#222" Foreground="White" Padding="5,1" Margin="0,0,3,0" ToolTip="Sound wählen"/>
                                                            <Button Content="✕" Command="{Binding ClearSoundCommand}" Background="#222" Foreground="#AAA" Padding="5,1" Margin="0,0,10,0" ToolTip="Sound entfernen"/>

                                                            <!-- Lautstärke-Slider -->
                                                            <TextBlock Text="🔊" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                                            <Slider Value="{Binding Volume, Mode=TwoWay}" 
                                                                    Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" 
                                                                    Width="70" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Volume, StringFormat=Lautstärke: {0:P0}}"/>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- Punktestand -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Points}" FontSize="22" FontWeight="Bold" Foreground="#00FF7F" VerticalAlignment="Center" Margin="15,0"/>

                                                    <!-- Steuerung (+ / -) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Button Content="-" Command="{Binding DecrementCommand}" Width="28" Height="28" Background="#444" Foreground="White" FontWeight="Bold" Margin="0,0,4,0"/>
                                                        <Button Content="+" Command="{Binding IncrementCommand}" Width="28" Height="28" Background="#444" Foreground="White" FontWeight="Bold"/>
                                                    </StackPanel>

                                                    <!-- Einzelnen Zähler aus dem Abschnitt löschen -->
                                                    <Button Grid.Column="3" Content="🗑" 
                                                            Command="{Binding DataContext.RemoveCounterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                            CommandParameter="{Binding}"
                                                            Width="25" Height="25" Background="#8B0000" Foreground="White" VerticalAlignment="Center" ToolTip="Zähler löschen"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Statusleiste -->
        <TextBlock Grid.Row="2" Text="Globale Hotkeys gelten stets für den aktuellsten (untersten) Abschnitt." 
                   Foreground="#888" FontSize="11" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>